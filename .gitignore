__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.coverage
coverage.xml
dist/
build/
*.egg-info/
banco.db

# Conteudo pessoal importado: protegido, mas a estrutura de pastas
# permanece rastreada via os arquivos .gitkeep.
acervo/pdfs/*
!acervo/pdfs/.gitkeep
acervo/imagens/*
!acervo/imagens/.gitkeep
acervo/notas/*
!acervo/notas/.gitkeep
acervo/links/*
!acervo/links/.gitkeep
acervo/documentos/*
!acervo/documentos/.gitkeep

# Indice semantico (ChromaDB) -- dados derivados, nao versionados.
vetores/*
!vetores/.gitkeep

# Backups contem uma copia integral do acervo pessoal: nunca versionar.
backups/*
!backups/.gitkeep
