__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.coverage
coverage.xml
dist/
build/
*.egg-info/
banco.db
chroma_db/

# Conteudo pessoal importado: protegido, mas a estrutura de pastas
# permanece rastreada via os arquivos .gitkeep.
acervo/pdfs/*
!acervo/pdfs/.gitkeep
acervo/imagens/*
!acervo/imagens/.gitkeep
acervo/audio/*
!acervo/audio/.gitkeep
acervo/videos/*
!acervo/videos/.gitkeep
acervo/notas/*
!acervo/notas/.gitkeep
acervo/links/*
!acervo/links/.gitkeep
acervo/documentos/*
!acervo/documentos/.gitkeep
acervo/planilhas/*
!acervo/planilhas/.gitkeep

# Indice semantico (ChromaDB) e backups: dados pessoais gerados
# localmente, nunca versionados. Estrutura de pastas mantida via
# .gitkeep, mesmo padrao ja usado em acervo/.
vetores/*
!vetores/.gitkeep
backups/*
!backups/.gitkeep

# Preferencias pessoais/locais (ex.: tema); o app recria com valores padrao.
config.json
